// expect-exit: 0
import std::str;

fn main() -> reg i32 {
    reg bad: i32 = 0
    if (std::str::find("hello world", "world") != 6) { bad = bad + 1 }
    if (std::str::find("hello world", "hello") != 0) { bad = bad + 1 }
    if (std::str::find("hello world", "o w") != 4) { bad = bad + 1 }
    if (std::str::find("hello", "xyz") != 0 - 1) { bad = bad + 1 }
    if (std::str::find("abc", "abcd") != 0 - 1) { bad = bad + 1 }
    if (std::str::find("abc", "") != 0) { bad = bad + 1 }
    if (std::str::find("aab", "ab") != 1) { bad = bad + 1 }
    if (std::str::contains("hello", "ell") != 1) { bad = bad + 1 }
    if (std::str::contains("hello", "elo") != 0) { bad = bad + 1 }
    if (std::str::find_byte("hello", 108) != 2) { bad = bad + 1 }
    if (std::str::find_byte("hello", 122) != 0 - 1) { bad = bad + 1 }
    if (std::str::count_byte("banana", 97) != 3) { bad = bad + 1 }
    if (std::str::count_byte("banana", 120) != 0) { bad = bad + 1 }
    return(bad)
}
