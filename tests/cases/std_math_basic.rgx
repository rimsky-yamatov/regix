// expect-exit: 0
import std::math;

fn main() -> reg i32 {
    reg bad: i32 = 0
    if (std::math::abs(0 - 5) != 5) { bad = bad + 1 }
    if (std::math::abs(5) != 5) { bad = bad + 1 }
    if (std::math::abs(0) != 0) { bad = bad + 1 }
    if (std::math::min(3, 7) != 3) { bad = bad + 1 }
    if (std::math::min(7, 3) != 3) { bad = bad + 1 }
    if (std::math::max(3, 7) != 7) { bad = bad + 1 }
    if (std::math::max(0 - 3, 0 - 7) != 0 - 3) { bad = bad + 1 }
    if (std::math::clamp(5, 1, 3) != 3) { bad = bad + 1 }
    if (std::math::clamp(0 - 5, 1, 3) != 1) { bad = bad + 1 }
    if (std::math::clamp(2, 1, 3) != 2) { bad = bad + 1 }
    if (std::math::sign(0 - 9) != 0 - 1) { bad = bad + 1 }
    if (std::math::sign(0) != 0) { bad = bad + 1 }
    if (std::math::sign(9) != 1) { bad = bad + 1 }
    if (std::math::is_even(4) != 1) { bad = bad + 1 }
    if (std::math::is_even(0 - 3) != 0) { bad = bad + 1 }
    if (std::math::is_odd(0 - 3) != 1) { bad = bad + 1 }
    return(bad)
}
