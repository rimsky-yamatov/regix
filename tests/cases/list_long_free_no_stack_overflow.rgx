// expect-exit: 0
// 200000 nodes are released by a loop, not by recursion.
struct Node {
    value: i32,
    heap next: Node,
}

fn push(heap list: Node, reg v: i32) -> heap Node {
    heap n: Node = Node { value: v, next: list }
    return(n)
}

fn sum(stack head: &Node) -> reg i32 {
    stack cur: &Node = head
    reg total: i32 = cur.value
    while (cur.next != null) {
        cur = &cur.next
        total = total + cur.value
    }
    return(total)
}

fn length(stack head: &Node) -> reg i32 {
    stack cur: &Node = head
    reg n: i32 = 1
    while (cur.next != null) {
        cur = &cur.next
        n = n + 1
    }
    return(n)
}

fn main() -> reg i32 {
    heap list: Node = Node { value: 0, next: null }
    reg i: i32 = 1
    while (i < 200000) {
        list = push(list, i)
        i = i + 1
    }
    return(0)
}
