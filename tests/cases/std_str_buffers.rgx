// expect-exit: 0
import std::str;

fn main() -> reg i32 {
    reg bad: i32 = 0
    stack buf: [u8; 8] = [0; 8]
    reg n: i32 = std::str::copy_into(&mut buf, "abc")
    if (n != 3) { bad = bad + 1 }
    if (buf[0] != 97 || buf[2] != 99 || buf[3] != 0) { bad = bad + 1 }
    stack small: [u8; 2] = [0; 2]
    if (std::str::copy_into(&mut small, "xyz") != 2) { bad = bad + 1 }
    if (small[1] != 121) { bad = bad + 1 }
    std::str::fill(&mut buf, 65)
    if (buf[0] != 65 || buf[7] != 65) { bad = bad + 1 }
    stack word: [u8; 5] = "hello"
    std::str::reverse(&mut word)
    if (std::str::eq(word, "olleh") != 1) { bad = bad + 1 }
    return(bad)
}
