// expect-exit: 0
struct Cell {
    v: i32,
}

struct Holder {
    heap cell: Cell,
}

struct Outer {
    id: i32,
    inner: Holder,
}

fn main() -> reg i32 {
    reg i: i32 = 0
    while (i < 20000) {
        stack o: Outer = Outer { id: i, inner: Holder { cell: Cell { v: 1 } } }
        i = i + 1
    }
    return(0)
}
