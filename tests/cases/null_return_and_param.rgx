// expect-exit: 3
struct Node {
    value: i32,
    heap next: Node,
}

fn push(heap list: Node, reg v: i32) -> heap Node {
    heap n: Node = Node { value: v, next: list }
    return(n)
}

fn sum(stack head: &Node) -> reg i32 {
    stack cur: &Node = head
    reg total: i32 = cur.value
    while (cur.next != null) {
        cur = &cur.next
        total = total + cur.value
    }
    return(total)
}

fn length(stack head: &Node) -> reg i32 {
    stack cur: &Node = head
    reg n: i32 = 1
    while (cur.next != null) {
        cur = &cur.next
        n = n + 1
    }
    return(n)
}

fn empty() -> heap Node {
    return(null)
}

fn is_empty(heap l: Node) -> reg i32 {
    if (l == null) { return(1) }
    return(0)
}

fn main() -> reg i32 {
    heap e: Node = empty()
    reg a: i32 = is_empty(null)
    heap x: Node = empty()
    reg b: i32 = is_empty(x)
    return(a + b + 1)
}
