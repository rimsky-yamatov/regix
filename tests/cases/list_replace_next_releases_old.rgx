// expect-exit: 8
struct Node {
    value: i32,
    heap next: Node,
}

fn push(heap list: Node, reg v: i32) -> heap Node {
    heap n: Node = Node { value: v, next: list }
    return(n)
}

fn sum(stack head: &Node) -> reg i32 {
    stack cur: &Node = head
    reg total: i32 = cur.value
    while (cur.next != null) {
        cur = &cur.next
        total = total + cur.value
    }
    return(total)
}

fn length(stack head: &Node) -> reg i32 {
    stack cur: &Node = head
    reg n: i32 = 1
    while (cur.next != null) {
        cur = &cur.next
        n = n + 1
    }
    return(n)
}

fn main() -> reg i32 {
    heap old: Node = Node { value: 7, next: null }
    heap fresh: Node = Node { value: 8, next: null }
    heap head: Node = Node { value: 1, next: old }
    head.next = fresh
    return(head.next.value)
}
