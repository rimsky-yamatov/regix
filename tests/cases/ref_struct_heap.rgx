// expect-exit: 12
struct Point {
    x: i32,
    y: i32,
}

fn shift(stack p: &mut Point, reg dx: i32) -> void {
    p.x = p.x + dx
}

fn sum(stack p: &Point) -> reg i32 {
    return(p.x + p.y)
}

fn main() -> reg i32 {
    heap h: Point = Point { x: 5, y: 6 }
    shift(&mut h, 1)
    return(sum(&h))
}
