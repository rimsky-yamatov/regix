// std::math: integer helpers. All values are i32 and arithmetic wraps on
// overflow (abs of the smallest i32 stays negative).
package std::math;

pub fn abs(reg x: i32) -> reg i32 {
    if (x < 0) {
        return(0 - x)
    }
    return(x)
}

pub fn min(reg a: i32, reg b: i32) -> reg i32 {
    if (a < b) {
        return(a)
    }
    return(b)
}

pub fn max(reg a: i32, reg b: i32) -> reg i32 {
    if (a > b) {
        return(a)
    }
    return(b)
}

// x limited to the range lo..=hi (lo is returned if x < lo, hi if x > hi).
pub fn clamp(reg x: i32, reg lo: i32, reg hi: i32) -> reg i32 {
    if (x < lo) {
        return(lo)
    }
    if (x > hi) {
        return(hi)
    }
    return(x)
}

// -1, 0 or 1.
pub fn sign(reg x: i32) -> reg i32 {
    if (x < 0) {
        return(0 - 1)
    }
    if (x > 0) {
        return(1)
    }
    return(0)
}

pub fn is_even(reg x: i32) -> reg i32 {
    return(x % 2 == 0)
}

pub fn is_odd(reg x: i32) -> reg i32 {
    return(x % 2 != 0)
}

// base to the power exp; 0 if exp is negative.
pub fn pow(reg base: i32, reg exp: i32) -> reg i32 {
    if (exp < 0) {
        return(0)
    }
    reg result: i32 = 1
    reg b: i32 = base
    reg e: i32 = exp
    while (e > 0) {
        if (e % 2 == 1) {
            result = result * b
        }
        b = b * b
        e = e / 2
    }
    return(result)
}

// n! for 0 <= n; wraps for n > 12.
pub fn factorial(reg n: i32) -> reg i32 {
    reg result: i32 = 1
    reg k: i32 = 2
    while (k <= n) {
        result = result * k
        k = k + 1
    }
    return(result)
}

// Greatest common divisor, never negative; gcd(0, 0) is 0.
pub fn gcd(reg a: i32, reg b: i32) -> reg i32 {
    reg x: i32 = abs(a)
    reg y: i32 = abs(b)
    while (y != 0) {
        reg t: i32 = x % y
        x = y
        y = t
    }
    return(x)
}

// Floor of the square root; 0 for n <= 0.
pub fn isqrt(reg n: i32) -> reg i32 {
    if (n <= 0) {
        return(0)
    }
    reg lo: i32 = 0
    reg hi: i32 = 46340
    while (lo < hi) {
        reg mid: i32 = (lo + hi + 1) / 2
        if (mid * mid <= n) {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    return(lo)
}
