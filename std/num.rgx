// std::num: converting between i32 and text.
package std::num;

import std::str;

// Parses an optionally signed decimal number. Returns 1 and stores the value
// in *out, or returns 0 and leaves *out alone if the text is empty, contains
// anything else, or does not fit (the smallest i32 is not accepted).
pub fn parse_i32(stack s: &[u8], stack out: &mut i32) -> reg i32 {
    reg i: i32 = 0
    reg neg: i32 = 0
    if (s.len == 0) {
        return(0)
    }
    if (s[0] == 45) {
        neg = 1
        i = 1
    } else if (s[0] == 43) {
        i = 1
    }
    if (i == s.len) {
        return(0)
    }
    reg v: i32 = 0
    while (i < s.len) {
        reg d: i32 = s[i] - 48
        if (d < 0 || d > 9) {
            return(0)
        }
        if (v > (2147483647 - d) / 10) {
            return(0)
        }
        v = v * 10 + d
        i = i + 1
    }
    if (neg) {
        v = 0 - v
    }
    *out = v
    return(1)
}

// Writes n in decimal into buf and returns the number of bytes written, or 0
// if it does not fit (an i32 needs at most 11 bytes).
pub fn format_i32(reg n: i32, stack buf: &mut [u8]) -> reg i32 {
    stack tmp: [u8; 12] = [0; 12]
    stack count: i32 = 0
    {
        reg v: i32 = n
        if (v == 0) {
            tmp[0] = 48
            count = 1
        }
        while (v != 0) {
            reg d: i32 = v % 10
            if (d < 0) {
                d = 0 - d
            }
            tmp[count] = 48 + d
            count = count + 1
            v = v / 10
        }
    }
    stack total: i32 = count
    if (n < 0) {
        total = total + 1
    }
    if (total > buf.len) {
        return(0)
    }
    stack pos: i32 = 0
    if (n < 0) {
        buf[0] = 45
        pos = 1
    }
    stack k: i32 = count
    while (k > 0) {
        k = k - 1
        buf[pos] = tmp[k]
        pos = pos + 1
    }
    return(total)
}

// Number of decimal digits of n (the sign is not counted); 1 for 0.
pub fn digits(reg n: i32) -> reg i32 {
    if (n == 0) {
        return(1)
    }
    reg v: i32 = n
    reg count: i32 = 0
    while (v != 0) {
        count = count + 1
        v = v / 10
    }
    return(count)
}
