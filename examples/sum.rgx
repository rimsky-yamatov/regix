import std::io;

fn sum(stack s: &[i32]) -> reg i32 {
    reg i: i32 = 0
    reg total: i32 = 0
    while (i < s.len) {
        total = total + s[i]
        i = i + 1
    }
    return(total)
}

fn main() -> reg i32 {
    stack nums: [i32; 5] = [1, 2, 3, 4, 5]
    std::io::print_i32(sum(&nums))   // 15
    return(0)
}
